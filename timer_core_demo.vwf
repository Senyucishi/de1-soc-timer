/*
Behavioral simulation of timer_core, captured from GHDL.
CLOCK_HZ = 8 for this simulation. Clock period = 20 ns.
Inputs mode_press and adjust_press are one-cycle button events.
mode_code: 0 run, 1 second, 2 minute, 3 hour, 4 day, 5 month,
           6 year, 7 weekday.
0 ns reset; 210 and 370 ns normal ticks; 470 ns edit mode;
810 ns first manual second increment; 8730 ns run mode resumes;
8810 ns 23:59:59; 8970 ns 2001-01-01 00:00:00; 9130 ns second 1.
year_digits is the two-digit year suffix; weekdays are Monday = 1 to Sunday = 7.
This VWF contains the recorded inputs and outputs for viewing.
*/

HEADER
{
	VERSION = 1;
	TIME_UNIT = ns;
	DATA_OFFSET = 0.0;
	DATA_DURATION = 9280.0;
	SIMULATION_TIME = 0.0;
	GRID_PHASE = 0.0;
	GRID_PERIOD = 20.0;
	GRID_DUTY_CYCLE = 50;
}

SIGNAL("clk")
{
	VALUE_TYPE = NINE_LEVEL_BIT;
	SIGNAL_TYPE = SINGLE_BIT;
	WIDTH = 1;
	LSB_INDEX = -1;
	DIRECTION = INPUT;
	PARENT = "";
}

