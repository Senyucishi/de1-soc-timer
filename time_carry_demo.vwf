/*
HH:MM:SS carry, captured from GHDL.
CLOCK_HZ = 4 for this simulation. Clock period = 20 ns.
50 ns preset 12:58:58; 210 ns 12:59:00; 5010 ns 13:00:00.
Each carry enables the next counter on the same rising clock edge.
*/

HEADER
{
	VERSION = 1;
	TIME_UNIT = ns;
	DATA_OFFSET = 0.0;
	DATA_DURATION = 5120.0;
	SIMULATION_TIME = 0.0;
	GRID_PHASE = 0.0;
	GRID_PERIOD = 20.0;
	GRID_DUTY_CYCLE = 50;
}

